+## Host owns spawned nodes; roster removal must also despawn the abandoned avatar.
+func _prune_departed_players() -> void:
+	if not Net.is_host():
+		return
+	for node in $Combatants.get_children():
+		if node.is_in_group("player") and not Net.players.has(int(node.combatant_id)):
+			Game.unregister_combatant(int(node.combatant_id))
+			node.queue_free()  # MultiplayerSpawner propagates despawn to remaining peers.
 
